<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- atlas-contracts is PUBLIC, Apache-2.0 (handbook 02 §3, AGENTS.md §2). -->
    <Company>VEV Software ApS</Company>
    <Product>Atlas</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>VEV Software ApS</Authors>
    <RepositoryUrl>https://github.com/Vev-software/atlas-contracts</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Contracts are versioned; breaking is expensive (AGENTS.md §4, 03 · E3).
         The version is derived from the git tag by MinVer: tag `vX.Y.Z` produces
         package version X.Y.Z, and commits after a tag produce a pre-release. The
         tag is the single source of truth — there is no hand-maintained version
         number in this repo. See docs/releasing.md. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: sets Version/PackageVersion from the git tag. -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
